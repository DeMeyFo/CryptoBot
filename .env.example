BITGET_API_KEY=your_api_key_here
BITGET_SECRET_KEY=your_secret_key_here
BITGET_PASSPHRASE=your_passphrase_here

# Keep true until a sufficiently long forward test is profitable after all costs.
DRY_RUN=true
LEVERAGE=5

# Direction filter. Over 24 months on 8 symbols, shorts had a lower profit
# factor than longs in both independent halves, and trading both directions
# roughly doubled the drawdown in the second half. long | short | both
TRADE_DIRECTION=long

# Sizing mode. "percent" scales the notional ceiling, floor and daily loss stop
# with equity, so the percentage return does not shrink as the account grows.
# "absolute" restores the legacy fixed-USDT behaviour below.
SIZING_MODE=percent

# Percent-mode sizing (fractions of equity).
RISK_PER_TRADE_PCT=0.005
MAX_POSITION_PCT=1.0
MIN_POSITION_PCT=0.01
DAILY_LOSS_LIMIT_PCT=0.05

# Exposure ceilings as a multiple of equity. Risk sizing bounds the loss only
# while the stop fills at its price; these bound it when it does not (gap,
# liquidity hole, dead process). Measured cost at 0.5% risk over 24 months: none.
MAX_SYMBOL_EXPOSURE_PCT=1.5
MAX_GROSS_EXPOSURE_PCT=3.5

MAX_OPEN_POSITIONS=8

# Pyramiding: add to a winner every PYRAMID_STEP_R of favourable excursion,
# measured against the original entry risk. 0 disables it.
# Measured over 24 months with half-size adds: monthly return 3.10% -> 4.35%
# and the best profit factor of the study (1.365), but drawdown 37.5% -> 47.9%.
# It won two of four independent half-years and lost the other two, and the
# holdout half fell from 2.16% to 0.96% per month. This is a bet on trend
# persistence, not a validated edge. Leave at 0 unless you accept that.
PYRAMID_MAX_ADDS=0
PYRAMID_STEP_R=1.0
PYRAMID_RISK_FRACTION=0.5

# Absolute-mode sizing. Only used when SIZING_MODE=absolute.
# Order notional (not margin); leverage only changes required margin.
POSITION_SIZE_USDT=50
MAX_POSITION_USDT=50
MIN_POSITION_USDT=30
DAILY_LOSS_LIMIT_USDT=25

# Validated trend-breakout defaults.
STRATEGY_TIMEFRAME=1H
DONCHIAN_PERIOD=55
# Trend-strength gate. 40 cut the drawdown roughly threefold in both halves of
# the 24-month study and lifted the profit factor in both, at the cost of about
# half the trades. Anything in the 30-45 range showed the same direction.
# Because it frees up so much drawdown budget, RISK_PER_TRADE_PCT=0.015 with
# this filter measured a similar drawdown to 0.005 without it, at roughly
# double the holdout return.
ADX_ENTRY_THRESHOLD=40
MAX_SIGNAL_AGE_SECONDS=180
TREND_STOP_ATR_MULTIPLIER=2.5
TREND_TRAIL_ATR_MULTIPLIER=2.5
TRAILING_ACTIVATION_R=1.0
USE_FIXED_TAKE_PROFIT=false
# Secondary 4H sleeve for diversification. Measured effect over 24 months:
# Sortino 1.61 -> 2.13, median month +1.32% -> +3.14%, drawdown 18.3% -> 15.2%.
# Set RISK_PER_TRADE_PCT=0.03 and SECONDARY_RISK_PER_TRADE_PCT=0.005 for 80/20.
SECONDARY_ENABLED=false
SECONDARY_TIMEFRAME=4H
SECONDARY_RISK_PER_TRADE_PCT=0.005

TOP_COINS_COUNT=8
LOOP_INTERVAL=300

# Entry order type: 'market' (taker fees) or 'limit' (maker fees, better fills).
# Limit orders place at close - PULLBACK_ATR * ATR and expire after one candle.
# Measured effect: Sortino 2.13 -> 2.58, median month +3.14% -> +4.06%.
ENTRY_ORDER_TYPE=market
LIMIT_PULLBACK_ATR=0.3

# Volatility-adaptive risk scaling: reduce risk in volatile markets,
# increase in calm markets. Measured effect: positive months 52% -> 56%.
VOL_ADAPTIVE_ENABLED=false
VOL_ADAPTIVE_LOOKBACK=336
VOL_ADAPTIVE_LOW_MULT=1.3
VOL_ADAPTIVE_HIGH_MULT=0.7

# Conservative market-order cost assumptions used in PnL/backtests.
TAKER_FEE_RATE=0.0006
SLIPPAGE_RATE=0.0002

# Optional funding reconciliation limits (minimum interval is always 60s).
FUNDING_SYNC_INTERVAL_SECONDS=60
FUNDING_SYNC_OVERLAP_SECONDS=86400
FUNDING_SYNC_CLOSE_GRACE_SECONDS=86400
FUNDING_SYNC_PAGE_SIZE=100
FUNDING_SYNC_MAX_PAGES=10
FUNDING_MARK_WINDOW_MS=180000
FUNDING_RATE_MATCH_TOLERANCE_SECONDS=300

# Delta-neutral Funding-Carry (Spot long + Perp short)
# Verdient die Funding-Rate ohne Richtungsrisiko. ~0.5-2%/Monat in normalen
# Zeiten, stabilisiert die Equity-Kurve in Seitwaertsphasen.
# Braucht Spot-Handels-Berechtigung auf dem API-Key.
CARRY_ENABLED=false
CARRY_MIN_RATE=0.0001
CARRY_EXIT_RATE=-0.0001
CARRY_MAX_POSITION_PCT=0.15
CARRY_MAX_TOTAL_PCT=0.40
CARRY_CHECK_INTERVAL=3600

# Optional diagnostic features.
USE_CLAUDE_SENTIMENT=false
CLAUDE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
